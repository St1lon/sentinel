# Пример окружения. Скопируйте в .env и при необходимости поправьте значения:
#   cp .env.example .env
#
# Файл .env не попадает в репозиторий (см. .gitignore) — это граница между
# кодом и конфигурацией: код один и тот же, значения различаются по окружениям.

# ---------- Общее ----------
# development | staging | production
APP_ENV=development
APP_VERSION=dev

# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# ---------- PostgreSQL ----------
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
# Порт, на котором БД доступна с хоста.
POSTGRES_PORT=5432

# DSN для запуска процессов НЕ в compose (локально через make run-api).
# Внутри compose DATABASE_URL формируется автоматически с хостом postgres.
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel?sslmode=disable

POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

# ---------- HTTP API ----------
HTTP_PORT=8080
# Порт, на котором API доступен с хоста (через compose).
API_PORT=8081
# Порт фронтенда (nginx) на хосте.
WEB_PORT=8080
HTTP_CORS_ALLOWED_ORIGINS=*

# ---------- Аутентификация ----------
# ОБЯЗАТЕЛЬНО поменяйте в любом окружении кроме локального:
# при APP_ENV=production это значение отклоняется на старте.
AUTH_JWT_SECRET=change-me-in-production-at-least-32-chars
AUTH_TOKEN_TTL=24h
AUTH_BCRYPT_COST=10

# ---------- Воркер проверок ----------
WORKER_CONCURRENCY=8
WORKER_BATCH_SIZE=50
WORKER_POLL_INTERVAL=1s
WORKER_USER_AGENT=SentinelUptimeBot/1.0
WORKER_MAX_RESPONSE_BYTES=65536
WORKER_MAX_REDIRECTS=3

# Разрешить проверки приватных и loopback-адресов.
# true — только для локальных экспериментов: иначе сервис превращается
# в инструмент сканирования внутренней сети (SSRF).
WORKER_ALLOW_PRIVATE_TARGETS=false

# ---------- Очистка истории проверок ----------
RETENTION_CHECK_DAYS=30
RETENTION_BATCH_SIZE=10000

# ---------- Таймауты корректного завершения ----------
# Сколько процесс даёт активной работе доиграть по SIGTERM.
HTTP_SHUTDOWN_TIMEOUT=15s
WORKER_SHUTDOWN_TIMEOUT=30s
