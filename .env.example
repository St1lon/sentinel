# Скопируйте в .env: cp .env.example .env
# Файл .env в репозиторий не попадает.

APP_ENV=development
APP_VERSION=dev

LOG_LEVEL=info
LOG_FORMAT=json

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
POSTGRES_PORT=5432
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

# DSN для запуска процессов вне compose. Внутри compose он формируется сам.
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel?sslmode=disable

HTTP_PORT=8080
API_PORT=8081
WEB_PORT=8080
HTTP_CORS_ALLOWED_ORIGINS=*
HTTP_SHUTDOWN_TIMEOUT=15s

# При APP_ENV=production это значение отклоняется на старте.
AUTH_JWT_SECRET=change-me-in-production-at-least-32-chars
AUTH_TOKEN_TTL=24h
AUTH_BCRYPT_COST=10

WORKER_CONCURRENCY=8
WORKER_BATCH_SIZE=50
WORKER_POLL_INTERVAL=1s
WORKER_SHUTDOWN_TIMEOUT=30s
WORKER_USER_AGENT=SentinelUptimeBot/1.0
WORKER_MAX_RESPONSE_BYTES=65536
WORKER_MAX_REDIRECTS=3

# Разрешить проверки приватных и loopback-адресов (только для локальной отладки).
WORKER_ALLOW_PRIVATE_TARGETS=false

RETENTION_CHECK_DAYS=30
RETENTION_BATCH_SIZE=10000
