# Скопируйте в .env: cp .env.example .env
# Файл .env в репозиторий не попадает.

APP_ENV=development
APP_VERSION=dev

LOG_LEVEL=info
LOG_FORMAT=json

POSTGRES_USER=sentinel
# Обязателен, значения по умолчанию в compose нет.
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
POSTGRES_PORT=5432
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

# DSN для запуска процессов вне compose. Внутри compose он формируется сам.
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel?sslmode=disable

HTTP_PORT=8080
API_PORT=8081
WEB_PORT=8080
HTTP_CORS_ALLOWED_ORIGINS=*
HTTP_SHUTDOWN_TIMEOUT=15s

# При APP_ENV=production это значение отклоняется на старте.
AUTH_JWT_SECRET=change-me-in-production-at-least-32-chars
AUTH_TOKEN_TTL=24h
AUTH_BCRYPT_COST=10

WORKER_CONCURRENCY=8
WORKER_BATCH_SIZE=50
WORKER_POLL_INTERVAL=1s
WORKER_SHUTDOWN_TIMEOUT=30s
WORKER_USER_AGENT=SentinelUptimeBot/1.0
WORKER_MAX_RESPONSE_BYTES=65536
WORKER_MAX_REDIRECTS=3

# Разрешить проверки приватных и loopback-адресов (только для локальной отладки).
ALLOW_PRIVATE_TARGETS=false

RETENTION_CHECK_DAYS=30
RETENTION_BATCH_SIZE=10000

# Выделенный порт сбора метрик. У api он проброшен на хост, у воркера нет:
# он масштабируется, и фиксированный порт занял бы только первую реплику.
METRICS_PORT=9090
METRICS_PATH=/metrics
API_METRICS_PORT=9091

# Как часто воркер снимает срез состояния мониторов для gauge-метрик.
WORKER_STATS_INTERVAL=15s

# Куда разовая задача очистки отправляет свои метрики push-моделью.
# Пусто — отправка отключена: локально сборщика метрик нет.
METRICS_PUSH_URL=
METRICS_PUSH_TIMEOUT=5s

# Blackbox-пробер: ходит в API снаружи по сценарию критического
# пользовательского пути и отдаёт результат метриками SLI.
# Внутри compose адрес — http://api:8080, локально — порт, проброшенный на хост.
PROBER_TARGET_URL=http://localhost:8081
PROBER_INTERVAL=10s
PROBER_TIMEOUT=3s
# Те же значения, что создаёт scripts/demo.sh.
PROBER_LOGIN_EMAIL=demo@sentinel.local
PROBER_LOGIN_PASSWORD=demo-password-123
# Slug публичной страницы выдаётся при регистрации; пусто — шаг пропускается.
PROBER_STATUS_SLUG=
PROBER_USER_AGENT=SentinelProber/1.0
PROBER_METRICS_PORT=9092

# Управляемая деградация API для демонстрации SLI и SLO. Сбои вносятся
# только в /api/, проверки живости не трогаются. При APP_ENV=production
# любое включение отклоняется на старте.
# Переключать удобнее скриптом: scripts/chaos.sh errors 0.3
CHAOS_ERROR_RATE=0
CHAOS_LATENCY=0s
CHAOS_LATENCY_RATE=0
CHAOS_READYZ_FAIL=false
# Режимы для алертов на метрики рантайма: утечка горутин (горутин на запрос)
# и рост памяти (MiB на запрос), оба с предохранителями внутри.
CHAOS_GOROUTINE_LEAK=0
CHAOS_MEM_HOG_MB=0
