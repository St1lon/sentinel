# Фронтенд — статика без сборки: ни node_modules, ни bundler'а.
# nginx раздаёт файлы и проксирует /api в процесс api, поэтому браузер
# работает с одним origin и CORS в обычной работе не задействован.

FROM nginx:1.27-alpine

COPY deployments/nginx.conf /etc/nginx/conf.d/default.conf
COPY web/ /usr/share/nginx/html/

EXPOSE 80
