# nginx-unprivileged: мастер-процесс работает от uid 101, а не от root,
# и слушает порт 8080 — непривилегированный процесс не может занять порт ниже 1024.
FROM nginxinc/nginx-unprivileged:1.27.5-alpine

COPY deployments/nginx.conf /etc/nginx/conf.d/default.conf
COPY web/ /usr/share/nginx/html/

EXPOSE 8080
